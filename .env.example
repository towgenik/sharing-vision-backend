# Copy to .env and fill in. These match the MySQL container's env vars in the compose stack.

# Database (MySQL 8)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=article
MYSQL_USER=sv
MYSQL_PASSWORD=change-me

# HTTP
PORT=8080

# Optional override for the full DSN (takes precedence over the MYSQL_* vars above)
# DATABASE_URL=user:pass@tcp(host:3306)/article?parseTime=true&charset=utf8mb4&multiStatements=true
